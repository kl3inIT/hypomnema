#!/bin/sh
# Removes what pi kept for one chat on this machine once the chat is deleted (issue #484): the folder the launcher
# made for it (run/<chat>: its prompt, skills, models.json, settings.json and mcp.json) and its sessions (sessions/<chat>), as
# Hermes and pi-web remove a deleted session's files. Installed root-owned as /usr/local/bin/hypomnema-chat-rm; the
# control plane's user runs it as the coordinator user through the sudoers rule that names it, after the chat is gone
# from the database and its pi has ended. It accepts one chat id, of the exact shape the control plane makes (cht_
# and 26 characters of a-z and 2-7), so no other path is ever named. The chat's attachments, in its Bot's folder, are
# removed through the helper of the Bots' folders instead.
set -eu

# Where things are. The test (internal/controlplane/coordinator/chatrm_linux_test.go) runs this file with this line
# changed to a directory of its own.
user_home=/home/coordinator

home="$user_home/.hypomnema-coordinator"

usage() {
  echo "usage: hypomnema-chat-rm <chat id>" >&2
  exit 2
}

[ $# -eq 1 ] || usage
chat=$1

case "$chat" in
  cht_*) ;;
  *) usage ;;
esac
rest=${chat#cht_}
[ ${#rest} -eq 26 ] || usage
case "$rest" in
  *[!a-z2-7]*) usage ;;
esac

# rm does not follow a link it finds inside either folder; a folder that is not there is no failure.
rm -rf -- "$home/run/$chat" "$home/sessions/$chat"
