{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": ["dist/**", "src/routeTree.gen.ts", "src/api/generated/**", "src/components/**"],
    "rules": ["react-doctor/no-high-complexity-react-function"],
    "overrides": [
      {
        "files": ["src/routes/**"],
        "rules": ["react/only-export-components"]
      },
      {
        "files": ["src/features/tasks/task-panel.tsx"],
        "rules": ["react-doctor/query-mutation-missing-invalidation"]
      },
      {
        "files": ["src/features/tasks/use-transcript.ts"],
        "rules": ["react-doctor/no-set-state-after-await-in-effect"]
      }
    ]
  }
}
