{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y", "import", "vitest"],
  "jsPlugins": ["@shadcn/lint"],
  "ignorePatterns": [
    "dist/**",
    "src/routeTree.gen.ts",
    "src/api/generated/**",
    "src/components/ui/**",
    "src/components/reui/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "import/no-cycle": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-restyle": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@/components/ui/native-select",
            "message": "A choice uses Select (@/components/ui/select): the native list is drawn by the system (docs/conventions.md)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/routes/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["src/components/**", "src/lib/**", "src/hooks/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/components/ui/native-select",
                "message": "A choice uses Select (@/components/ui/select): the native list is drawn by the system (docs/conventions.md)."
              }
            ],
            "patterns": [
              {
                "group": ["@/features/**", "@/routes/**", "**/features/**", "**/routes/**"],
                "message": "components/, lib/ and hooks/ never import a feature or a route (docs/conventions.md, Web client)."
              }
            ]
          }
        ]
      }
    }
  ]
}
